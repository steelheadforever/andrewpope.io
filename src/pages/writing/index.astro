---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<Base title="Writing" description="Essays and notes by Andrew Pope.">
  <p class="cmd">
    <span class="you">andrew@pope</span> ~ <span class="sigil">$</span> ls writing/
  </p>
  <h1>Writing</h1>
  <p class="muted">
    Notes from the field that don't quite fit as projects. These are my own opinions, and not representative of any organization I'm a part of.
  </p>

  {
    posts.length === 0 ? (
      <p class="muted">Nothing published yet.</p>
    ) : (
      <ul class="entry-list">
        {posts.map((post) => (
          <li>
            <a href={`/writing/${post.id}`} class="entry-title">
              {post.data.title}
            </a>
            <span class="entry-meta"> — {fmt(post.data.date)}</span>
            {post.data.description && (
              <p class="entry-desc">{post.data.description}</p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</Base>
