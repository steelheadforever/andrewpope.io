---
import Base from "../layouts/Base.astro";

const apps = [
  {
    title: "Circuit Box",
    status: "building",
    desc: "Build a computer from nothing. Each level unlocks the last one's parts as black boxes — gate → NAND-universal → adder → flip-flop → register → ALU → a working 8-bit CPU.",
    href: undefined,
  },
];

const ideas = [
  "FPGA Playground",
  "PCB Design Notebook (tinywhoop board)",
  "Trust Stack BOM Visualizer",
  "On-Device Inference Explorer",
];
---

<Base
  title="Apps"
  description="Interactive, in-browser tools by Andrew Pope — each a public artifact of something I'm learning."
>
  <h1>Apps</h1>
  <p class="muted">
    Interactive tools, each a public artifact of something I'm learning.
  </p>

  <ul class="entry-list">
    {
      apps.map((a) => (
        <li>
          <span class="entry-title">{a.title}</span>{" "}
          <span class="badge">{a.status}</span>
          <p class="entry-desc">{a.desc}</p>
        </li>
      ))
    }
  </ul>

  <h2>On the list</h2>
  <ul class="entry-list">
    {
      ideas.map((i) => (
        <li>
          <span class="entry-title">{i}</span>{" "}
          <span class="entry-meta">— idea</span>
        </li>
      ))
    }
  </ul>
</Base>
