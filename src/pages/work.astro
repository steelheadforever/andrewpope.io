---
import Base from "../layouts/Base.astro";

const projects = [
  {
    title: "Circuit Box",
    meta: "in progress",
    desc: "Interactive logic-circuit builder organized by progressive levels of abstraction: gate → adder → flip-flop → register → ALU → 8-bit CPU.",
    href: "/apps",
  },
  {
    title: "Tinywhoop flight controller",
    meta: "hardware · STM32G473",
    desc: "A custom flight-controller board — the physical anchor for the chip course.",
    href: undefined,
  },
  {
    title: "On-device inference",
    meta: "ongoing",
    desc: "Local / on-device AI inference experiments and agentic tooling.",
    href: undefined,
  },
];
---

<Base title="Work" description="Things Andrew Pope has built and is building.">
  <p class="cmd">
    <span class="you">andrew@pope</span> ~ <span class="sigil">$</span> ls work/
  </p>
  <h1>Work</h1>
  <p class="muted">Things I've built and am building.</p>

  <ul class="entry-list">
    {
      projects.map((p) => (
        <li>
          {p.href ? (
            <a href={p.href} class="entry-title">
              {p.title}
            </a>
          ) : (
            <span class="entry-title">{p.title}</span>
          )}
          {p.meta && <> <span class="entry-meta">— {p.meta}</span></>}
          <p class="entry-desc">{p.desc}</p>
        </li>
      ))
    }
  </ul>
</Base>
