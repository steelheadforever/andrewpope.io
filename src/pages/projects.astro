---
import Base from "../layouts/Base.astro";

const projects = [
  {
    title: "Birdseed",
    tag: "hw",
    status: "building",
    href: "/writing/introducing-birdseed",
    desc: "A bird feeder camera that answers to no one's cloud. A Raspberry Pi Zero 2 W watches the feeder with a motion sensor and camera, captures each visitor, and serves the clips to a local web page on the home WiFi — no subscription, no server, no account. Built in public as I wrestle with the real constraints: power, solar, and whether the Pi was even the right call.",
  },
  {
    title: "Toy Soldiers",
    tag: "hw",
    status: undefined,
    href: undefined,
    desc: "A study of the origin of the components on a tiny whoop flight controller board. A tiny whoop is a small quadcopter (<20g typically) with integrated radio controls and a video transmitter. A small miracle of embedded systems, the tiny whoop also demonstrates where so many of our chips come from.",
  },
  {
    title: "Audiary",
    tag: "sw",
    status: undefined,
    href: "https://workingmodel.cc/audiary",
    desc: "Natural-sounding text-to-speech with Kokoro neural voices running on the Apple Neural Engine — fully on-device, no servers, no subscription. Share in an article, a webpage, a PDF, or your own notes and it reads them back, with real-time word highlighting and chapter navigation; Apple's system voices are there too, for when you want minimal battery draw. I built it because the good voices were all cloud-locked, and listening to your own documents shouldn't mean uploading them to someone else's machine.",
  },
  {
    title: "MoarPixels",
    tag: "sw",
    status: undefined,
    href: "https://workingmodel.cc/moarpixels",
    desc: "Upscales photos 4× per pass with an ESRGAN model, running on-device through Core ML — stack passes for up to 16× and print at poster size. No upload, no server, no ads. Same thesis as Audiary: the model runs on your phone, and your pictures never leave it.",
  },
  {
    title: "Phantom Ops",
    tag: "sw",
    status: undefined,
    href: "https://phantom-ops.net",
    desc: "A mission-planning and familiarization tool for USAF RPA students. It mirrors the map controls of an air-gapped simulator so aircrew can plan a sortie in a normal browser and carry the plan across. Built straight from the training need — the sim is isolated by design, which makes planning on it painful.",
  },
  {
    title: "Slackwater",
    tag: "sw",
    status: undefined,
    href: "https://slackwater.app",
    desc: "Tides and weather for the Texas coast in one place — everything a fisherman wants to check before heading out, without bouncing between five apps and a NOAA page. A small, useful thing I wanted to exist.",
  },
];
---

<Base
  title="Projects"
  description="Things Andrew Pope has built — hardware and software."
>
  <p class="cmd">
    <span class="you">andrew@pope</span> ~ <span class="sigil">$</span> ls projects/
  </p>
  <h1>Projects</h1>
  <p class="muted">Things I've built — hardware and software.</p>

  <ul class="entry-list">
    {
      projects.map((p) => (
        <li>
          {p.href ? (
            <a href={p.href} class="entry-title">
              {p.title}
            </a>
          ) : (
            <span class="entry-title">{p.title}</span>
          )}{" "}
          <span class="tag">[{p.tag}]</span>
          {p.status && (
            <>
              {" "}
              <span class="badge">{p.status}</span>
            </>
          )}
          <p class="entry-desc">{p.desc}</p>
        </li>
      ))
    }
  </ul>
</Base>
